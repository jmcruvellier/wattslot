	rdfs:label "a pour tarif"@fr , "has tariff"@en ;
	rdfs:range wattslot:Tariff .
wattslot:hasTimeConstraint a owl:ObjectProperty ;
	rdfs:domain wattslot:DeviceSettings ;
	rdfs:label "a pour contrainte horaire"@fr , "has time constraint"@en ;
	rdfs:range wattslot:TimeConstraint .
wattslot:importWeight a owl:DatatypeProperty ;
	rdfs:domain wattslot:Objective ;
	rdfs:label "import weight (euro equivalent)"@en , "poids du soutirage (équivalent euros)"@fr ;
	rdfs:range xsd:double .
wattslot:inverterKw a owl:DatatypeProperty ;
	rdfs:domain wattslot:SolarPanels ;
	rdfs:label "inverter power (kW)"@en , "puissance de l'onduleur (kW)"@fr ;
	rdfs:range xsd:double .
wattslot:key a owl:DatatypeProperty ;
	rdfs:domain wattslot:Device ;
	rdfs:label "clé stable de l'équipement"@fr , "stable device key"@en ;
	rdfs:range xsd:string .
wattslot:last a owl:DatatypeProperty ;
	rdfs:domain wattslot:Aggregate ;
	rdfs:label "valeur en fin de période"@fr , "value at the end of the period"@en ;
	rdfs:range xsd:double .
wattslot:locatedIn a owl:ObjectProperty ;
	rdfs:domain wattslot:Device ;
	rdfs:label "est situé dans"@fr , "located in"@en ;
	rdfs:range wattslot:Room .
wattslot:max a owl:DatatypeProperty ;
	rdfs:domain wattslot:Aggregate ;
	rdfs:label "maximum"@en , "maximum"@fr ;
	rdfs:range xsd:double .
wattslot:maxDelayDays a owl:DatatypeProperty ;
	rdfs:domain wattslot:DeviceSettings ;
	rdfs:label "postponement tolerance (days)"@en , "tolérance de report (jours)"@fr ;
	rdfs:range xsd:integer .
wattslot:maxKw a owl:DatatypeProperty ;
	rdfs:domain wattslot:EnergyNeed ;
	rdfs:label "maximum power (kW)"@en , "puissance maximale (kW)"@fr ;
	rdfs:range xsd:double .
wattslot:maxStarts a owl:DatatypeProperty ;
	rdfs:domain wattslot:RuntimeSettings ;
	rdfs:label "démarrages par jour au plus"@fr , "maximum starts per day"@en ;
	rdfs:range xsd:integer .
wattslot:mean a owl:DatatypeProperty ;
	rdfs:domain wattslot:Aggregate ;
	rdfs:label "moyenne pondérée par la durée"@fr , "time-weighted mean"@en ;
	rdfs:range xsd:double .
wattslot:minimumHours a owl:ObjectProperty ;
	rdfs:domain wattslot:RuntimeSettings ;
	rdfs:label "heures minimales par saison"@fr , "minimum hours per season"@en .
wattslot:month a owl:DatatypeProperty ;
	rdfs:domain wattslot:PriceBand ;
	rdfs:label "mois"@fr , "month"@en ;
	rdfs:range xsd:integer .
wattslot:needEnergyKwh a owl:DatatypeProperty ;
	rdfs:domain wattslot:EnergyNeed ;
	rdfs:label "energy to deliver (kWh)"@en , "énergie à fournir (kWh)"@fr ;
	rdfs:range xsd:double .
wattslot:objectivePreset a owl:DatatypeProperty ;
	rdfs:domain wattslot:Objective ;
	rdfs:label "preset (cost, autonomy, self_consumption, custom)"@en , "préréglage (cost, autonomy, self_consumption, custom)"@fr ;
	rdfs:range xsd:string .
wattslot:order a owl:DatatypeProperty ;
	rdfs:label "order"@en , "rang"@fr ;
	rdfs:range xsd:integer .
wattslot:panelsEfficiency a owl:DatatypeProperty ;
	rdfs:domain wattslot:SolarPanels ;
	rdfs:label "overall efficiency (excluding temperature)"@en , "rendement global (hors température)"@fr ;
	rdfs:range xsd:double .
wattslot:peakPowerKw a owl:DatatypeProperty ;
	rdfs:domain wattslot:PanelArray ;
	rdfs:label "peak power (kWp)"@en , "puissance crête (kWc)"@fr ;
	rdfs:range xsd:double .
wattslot:period a owl:DatatypeProperty ;
	rdfs:domain wattslot:Aggregate ;
	rdfs:label "period (ISO 8601 duration)"@en , "période (durée ISO 8601)"@fr ;
	rdfs:range xsd:string .
wattslot:planned a owl:DatatypeProperty ;
	rdfs:domain wattslot:DeviceSettings ;
	rdfs:label "planned by the engine"@en , "pris en compte par le calcul"@fr ;
	rdfs:range xsd:boolean .
wattslot:powerKw a owl:DatatypeProperty ;
	rdfs:label "power (kW)"@en , "puissance (kW)"@fr ;
	rdfs:range xsd:double .
wattslot:priceEntity a owl:DatatypeProperty ;
	rdfs:domain wattslot:Tariff ;
	rdfs:label "entité de prix"@fr , "price entity"@en ;
	rdfs:range xsd:string .
wattslot:priceEurKwh a owl:DatatypeProperty ;
	rdfs:domain wattslot:PriceBand ;
	rdfs:label "price (€/kWh)"@en , "prix (€/kWh)"@fr ;
	rdfs:range xsd:double .
wattslot:priceFactor a owl:DatatypeProperty ;
	rdfs:domain wattslot:Tariff ;
	rdfs:label "facteur d'unité des prix lus"@fr , "price unit factor"@en ;
	rdfs:range xsd:double .
wattslot:quantity a owl:AnnotationProperty ;
	rdfs:label "grandeur observée"@fr , "observed quantity"@en .
wattslot:recurrenceRule a owl:DatatypeProperty ;
	rdfs:domain wattslot:Recurrence ;
	rdfs:label "rule (RFC 5545)"@en , "règle (RFC 5545)"@fr ;
	rdfs:range xsd:string .
wattslot:recurrenceStart a owl:DatatypeProperty ;
	rdfs:domain wattslot:Recurrence ;
	rdfs:label "semaine de départ"@fr , "starting week"@en ;
	rdfs:range xsd:date .
wattslot:resetsDaily a owl:DatatypeProperty ;
	rdfs:domain wattslot:Sensor ;
	rdfs:label "remis à zéro chaque jour"@fr , "resets daily"@en ;
	rdfs:range xsd:boolean .
wattslot:role a owl:ObjectProperty ;
	rdfs:domain wattslot:Sensor ;
	rdfs:label "role"@en , "rôle"@fr ;
	rdfs:range wattslot:Role .
wattslot:season a owl:DatatypeProperty ;
	rdfs:label "saison"@fr , "season"@en ;
	rdfs:range xsd:string .
wattslot:skipDays a owl:ObjectProperty ;
	rdfs:domain wattslot:RuntimeSettings ;
	rdfs:label "days that can be skipped per season"@en , "jours sautables par saison"@fr .
wattslot:speedName a owl:DatatypeProperty ;
	rdfs:label "nom de la vitesse"@fr , "speed name"@en ;
	rdfs:range xsd:string .
wattslot:start a owl:DatatypeProperty ;
	rdfs:domain wattslot:Aggregate ;
	rdfs:label "début de la période"@fr , "period start"@en ;
	rdfs:range xsd:dateTime .
wattslot:startHour a owl:DatatypeProperty ;
	rdfs:domain wattslot:PriceBand ;
	rdfs:label "heure de début"@fr , "start hour"@en ;
	rdfs:range xsd:integer .
wattslot:startsAfterKey a owl:DatatypeProperty ;
	rdfs:domain wattslot:DeviceSettings ;
	rdfs:label "démarre après la fin du cycle de (clé de l'équipement)"@fr , "starts after the cycle of (device key)"@en ;
	rdfs:range xsd:string .
wattslot:steps a owl:DatatypeProperty ;
	rdfs:domain wattslot:EnergyNeed ;
	rdfs:label "in steps (all or nothing)"@en , "par paliers (tout ou rien)"@fr ;
	rdfs:range xsd:boolean .
wattslot:subscriptionEurMonth a owl:DatatypeProperty ;
	rdfs:domain wattslot:Tariff ;
	rdfs:label "abonnement mensuel (€)"@fr , "monthly subscription (€)"@en ;
	rdfs:range xsd:double .
wattslot:tiltDegrees a owl:DatatypeProperty ;
	rdfs:domain wattslot:PanelArray ;
	rdfs:label "inclinaison (°)"@fr , "tilt (°)"@en ;
	rdfs:range xsd:double .
wattslot:typeKey a owl:DatatypeProperty ;
	rdfs:comment "Type propre à une installation : sous-classe d'un type de la bibliothèque, déclarée dans le graphe de la maison."@fr ;
	rdfs:label "clé stable d'un type d'équipement propre"@fr , "stable key of a custom device type"@en ;
	rdfs:range xsd:string .
wattslot:value a owl:DatatypeProperty ;
	rdfs:label "valeur"@fr , "value"@en ;
	rdfs:range xsd:integer .
wattslot:weekday a owl:DatatypeProperty ;
	rdfs:domain wattslot:PriceBand ;
	rdfs:label "jour de la semaine (0 lundi)"@fr , "weekday (0 Monday)"@en ;
	rdfs:range xsd:integer .
<https://w3id.org/wattslot/ontology/library/home-energy> a owl:Ontology ;
	rdfs:label "Home energy"@en , "Énergie domestique"@fr ;
	owl:imports sosa: , ssn: , saref: , s4ener: ;
	owl:versionInfo "0.2" .
<https://w3id.org/wattslot/ontology/schema> a owl:Ontology ;
	rdfs:label "Schéma de WattSlot"@fr , "WattSlot schema"@en ;
	owl:imports <https://w3id.org/wattslot/ontology/library/home-energy> ;
	owl:versionInfo "0.1" .
