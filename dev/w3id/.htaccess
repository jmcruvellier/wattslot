# Redirections of https://w3id.org/wattslot/ (WattSlot, https://github.com/jmcruvellier/wattslot)
Options +FollowSymLinks
RewriteEngine on

# Turtle files, for RDF clients
RewriteCond %{HTTP_ACCEPT} (text/turtle|application/x-turtle|application/rdf\+xml|application/n-triples)
RewriteRule ^ontology$ https://raw.githubusercontent.com/jmcruvellier/wattslot/main/docs/ontology/ontology.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} (text/turtle|application/x-turtle|application/rdf\+xml|application/n-triples)
RewriteRule ^ontology/library/home-energy$ https://raw.githubusercontent.com/jmcruvellier/wattslot/main/docs/ontology/home-energy.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} (text/turtle|application/x-turtle|application/rdf\+xml|application/n-triples)
RewriteRule ^ontology/schema$ https://raw.githubusercontent.com/jmcruvellier/wattslot/main/docs/ontology/schema.ttl [R=303,L]

# Explicit files
RewriteRule ^ontology\.ttl$ https://raw.githubusercontent.com/jmcruvellier/wattslot/main/docs/ontology/ontology.ttl [R=303,L]
RewriteRule ^ontology/library/home-energy\.ttl$ https://raw.githubusercontent.com/jmcruvellier/wattslot/main/docs/ontology/home-energy.ttl [R=303,L]
RewriteRule ^ontology/schema\.ttl$ https://raw.githubusercontent.com/jmcruvellier/wattslot/main/docs/ontology/schema.ttl [R=303,L]

# Everything else: the documentation page (home/… only exists in each installation)
RewriteRule ^(ontology|home)(/.*)?$ https://github.com/jmcruvellier/wattslot/blob/main/docs/ontology/README.md [R=303,L]
RewriteRule ^$ https://github.com/jmcruvellier/wattslot [R=302,L]
