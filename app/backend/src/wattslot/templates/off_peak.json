{
  "format": "wattslot/template",
  "version": 1,
  "name": {
    "fr": "Heures creuses",
    "en": "Off-peak hours"
  },
  "description": {
    "fr": "Heures creuses de 0 h à 6 h et de 22 h à 24 h (prix indicatifs, à remplacer par les vôtres). Les appareils de votre maison reçoivent aussi des réglages habituels, modifiables ensuite.",
    "en": "Off-peak hours from midnight to 6 am and 10 pm to midnight (indicative prices, to replace with yours). The appliances of your home also get usual settings, which you can change afterwards."
  },
  "devices": [
    {
      "type": "WaterHeater",
      "behavior": "CycleBehavior",
      "recurrence": {
        "rule": "FREQ=DAILY;INTERVAL=2"
      }
    },
    {
      "type": "WashingMachine",
      "behavior": "CycleBehavior"
    },
    {
      "type": "Dryer",
      "behavior": "CycleBehavior",
      "after": "WashingMachine"
    },
    {
      "type": "Dishwasher",
      "behavior": "CycleBehavior"
    },
    {
      "type": "PoolPump",
      "behavior": "RuntimeBehavior",
      "runtime": {}
    },
    {
      "type": "heat_pump",
      "behavior": "RuntimeBehavior",
      "runtime": {
        "minimum_hours": {
          "summer": 0,
          "mid_season": 2,
          "winter": 4
        },
        "skip_days": {
          "summer": 365,
          "mid_season": 1,
          "winter": 0
        },
        "max_starts": 3
      }
    },
    {
      "type": "ev",
      "behavior": "EnergyByDeadlineBehavior",
      "energy": {
        "energy_kwh": 10,
        "earliest_hour": 0,
        "deadline_hour": 7,
        "max_kw": 7.4
      }
    }
  ],
  "tariff": {
    "kind": "TimeOfUseTariff",
    "base_eur_kwh": 0.27,
    "bands": [
      {
        "start_hour": 0,
        "end_hour": 6,
        "eur_kwh": 0.21
      },
      {
        "start_hour": 22,
        "end_hour": 24,
        "eur_kwh": 0.21
      }
    ],
    "export_eur_kwh": 0.0
  }
}
