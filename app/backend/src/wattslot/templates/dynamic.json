{
  "format": "wattslot/template",
  "version": 1,
  "name": {
    "fr": "Prix dynamique",
    "en": "Dynamic price"
  },
  "description": {
    "fr": "Prix horaires du marché lus dans une entité de Home Assistant. Les appareils de votre maison reçoivent aussi des réglages habituels, modifiables ensuite.",
    "en": "Hourly market prices read from a Home Assistant entity. The appliances of your home also get usual settings, which you can change afterwards."
  },
  "devices": [
    {
      "type": "WaterHeater",
      "behavior": "CycleBehavior",
      "recurrence": {
        "rule": "FREQ=DAILY;INTERVAL=2"
      }
    },
    {
      "type": "WashingMachine",
      "behavior": "CycleBehavior"
    },
    {
      "type": "Dryer",
      "behavior": "CycleBehavior",
      "after": "WashingMachine"
    },
    {
      "type": "Dishwasher",
      "behavior": "CycleBehavior"
    },
    {
      "type": "PoolPump",
      "behavior": "RuntimeBehavior",
      "runtime": {}
    },
    {
      "type": "heat_pump",
      "behavior": "RuntimeBehavior",
      "runtime": {
        "minimum_hours": {
          "summer": 0,
          "mid_season": 2,
          "winter": 4
        },
        "skip_days": {
          "summer": 365,
          "mid_season": 1,
          "winter": 0
        },
        "max_starts": 3
      }
    },
    {
      "type": "ev",
      "behavior": "EnergyByDeadlineBehavior",
      "energy": {
        "energy_kwh": 10,
        "earliest_hour": 0,
        "deadline_hour": 7,
        "max_kw": 7.4
      }
    }
  ],
  "tariff": {
    "kind": "DynamicTariff",
    "base_eur_kwh": 0.25,
    "export_eur_kwh": 0.0,
    "price_factor": 0.001
  }
}
