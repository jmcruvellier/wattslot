{
  "format": "wattslot/template",
  "version": 1,
  "name": {
    "fr": "Tempo",
    "en": "Tempo"
  },
  "description": {
    "fr": "Tarif Tempo : couleur du jour lue dans une entité de Home Assistant, heures creuses de 22 h à 6 h (prix indicatifs). Les appareils de votre maison reçoivent aussi des réglages habituels, modifiables ensuite.",
    "en": "Tempo tariff: day color read from a Home Assistant entity, off-peak hours from 10 pm to 6 am (indicative prices). The appliances of your home also get usual settings, which you can change afterwards."
  },
  "devices": [
    {
      "type": "WaterHeater",
      "behavior": "CycleBehavior",
      "recurrence": {
        "rule": "FREQ=DAILY;INTERVAL=2"
      }
    },
    {
      "type": "WashingMachine",
      "behavior": "CycleBehavior"
    },
    {
      "type": "Dryer",
      "behavior": "CycleBehavior",
      "after": "WashingMachine"
    },
    {
      "type": "Dishwasher",
      "behavior": "CycleBehavior"
    },
    {
      "type": "PoolPump",
      "behavior": "RuntimeBehavior",
      "runtime": {}
    },
    {
      "type": "heat_pump",
      "behavior": "RuntimeBehavior",
      "runtime": {
        "minimum_hours": {
          "summer": 0,
          "mid_season": 2,
          "winter": 4
        },
        "skip_days": {
          "summer": 365,
          "mid_season": 1,
          "winter": 0
        },
        "max_starts": 3
      }
    },
    {
      "type": "ev",
      "behavior": "EnergyByDeadlineBehavior",
      "energy": {
        "energy_kwh": 10,
        "earliest_hour": 0,
        "deadline_hour": 7,
        "max_kw": 7.4
      }
    }
  ],
  "tariff": {
    "kind": "DayColorTariff",
    "base_eur_kwh": 0.17,
    "export_eur_kwh": 0.0,
    "colors": [
      {
        "color": "Bleu",
        "base_eur_kwh": 0.17,
        "bands": [
          {
            "start_hour": 0,
            "end_hour": 6,
            "eur_kwh": 0.13
          },
          {
            "start_hour": 22,
            "end_hour": 24,
            "eur_kwh": 0.13
          }
        ]
      },
      {
        "color": "Blanc",
        "base_eur_kwh": 0.19,
        "bands": [
          {
            "start_hour": 0,
            "end_hour": 6,
            "eur_kwh": 0.15
          },
          {
            "start_hour": 22,
            "end_hour": 24,
            "eur_kwh": 0.15
          }
        ]
      },
      {
        "color": "Rouge",
        "base_eur_kwh": 0.66,
        "bands": [
          {
            "start_hour": 0,
            "end_hour": 6,
            "eur_kwh": 0.16
          },
          {
            "start_hour": 22,
            "end_hour": 24,
            "eur_kwh": 0.16
          }
        ]
      }
    ],
    "color_day_start_hour": 6
  }
}
